{%- comment -%}
  ============================================================
  Structured data (schema.org JSON-LD)
  ============================================================

  What search engines use for rich results (price, stock, breadcrumbs,
  sitelinks search box) and what AI assistants read to understand what
  the shop sells. Rendered once, in <head>, from layout/theme.liquid.

    Every page   Organization (+ OnlineStore type, logo, social profiles)
    Home         WebSite with SearchAction
    Product      Product + Offer per variant, BreadcrumbList
    Collection   CollectionPage + ItemList, BreadcrumbList
    Article      handled by sections/main-article.liquid already

  aggregateRating is emitted ONLY from the real reviews metafield, never
  from demo ratings: structured data is read by Google and AI systems
  directly, and a rating no customer gave is a fabricated review.

  Every value goes through | json, so quotes and markup in titles or
  descriptions can never break the script.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign same_as = ''
  assign social_keys = 'social_facebook_link,social_instagram_link,social_youtube_link,social_tiktok_link,social_twitter_link,social_pinterest_link' | split: ','
  for key in social_keys
    assign link = settings[key]
    if link != blank
      assign same_as = same_as | append: link | append: '|'
    endif
  endfor
  assign same_as = same_as | split: '|'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "OnlineStore"],
    "@id": {{ request.origin | append: '/#organization' | json }},
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }}
    {%- if settings.logo != blank -%},
    "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if shop.description != blank -%},
    "description": {{ shop.description | json }}
    {%- endif -%}
    {%- if shop.email != blank -%},
    "email": {{ shop.email | json }}
    {%- endif -%}
    {%- if same_as.size > 0 -%},
    "sameAs": {{ same_as | json }}
    {%- endif -%}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- comment -%} Built in a capture: literal braces inside an output tag break the parser. {%- endcomment -%}
  {%- capture search_tpl -%}{{ request.origin }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ request.origin | append: '/#website' | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ search_tpl | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- liquid
    assign p_rating = product.metafields.reviews.rating.value
    assign p_count = product.metafields.reviews.rating_count
    assign p_desc = product.description | strip_html | strip_newlines | strip | truncate: 5000
    if p_desc == blank
      assign p_desc = product.title
    endif
    assign valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ p_desc | json }},
      {%- if product.featured_media -%}
      "image": [
        {%- for media in product.media limit: 6 -%}
          {%- if media.preview_image -%}
            {{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ],
      {%- endif -%}
      {%- if product.vendor != blank -%}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- endif -%}
      {%- if product.type != blank -%}
      "category": {{ product.type | json }},
      {%- endif -%}
      {%- assign first_v = product.selected_or_first_available_variant -%}
      {%- if first_v.sku != blank -%}
      "sku": {{ first_v.sku | json }},
      {%- endif -%}
      {%- if first_v.barcode != blank -%}
      "gtin": {{ first_v.barcode | json }},
      {%- endif -%}
      {%- if p_rating != blank and p_count != blank and p_count > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ p_rating.rating | json }},
        "bestRating": {{ p_rating.scale_max | default: 5 | json }},
        "worstRating": {{ p_rating.scale_min | default: 1 | json }},
        "ratingCount": {{ p_count | json }}
      },
      {%- endif -%}
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            {%- if variant.title != 'Default Title' -%}
            "name": {{ variant.title | json }},
            {%- endif -%}
            {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
            {%- endif -%}
            "url": {{ request.origin | append: variant.url | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "priceValidUntil": {{ valid_until | json }},
            "itemCondition": "https://schema.org/NewCondition",
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "seller": { "@id": {{ request.origin | append: '/#organization' | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  {%- liquid
    assign crumb_col = collection
    if crumb_col == blank
      assign crumb_col = product.collections | where: 'handle', 'all' | first
      if crumb_col == blank
        assign crumb_col = product.collections.first
      endif
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }} },
        {%- if crumb_col != blank -%}
        { "@type": "ListItem", "position": 2, "name": {{ crumb_col.title | json }}, "item": {{ request.origin | append: crumb_col.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
        {%- else -%}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ canonical_url | json }},
      {%- if collection.description != blank -%}
      "description": {{ collection.description | strip_html | strip_newlines | strip | truncate: 500 | json }},
      {%- endif -%}
      "isPartOf": { "@id": {{ request.origin | append: '/#website' | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | json }},
        "itemListElement": [
          {%- for p in collection.products limit: 24 -%}
            { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ request.origin | append: p.url | json }}, "name": {{ p.title | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  </script>
{%- endif -%}
